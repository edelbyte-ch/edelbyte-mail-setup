<Window x:Class="EdelByte.MailSetup.Ui.DiagnoseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdelByte Mail Setup – Diagnose" Height="520" Width="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Weiss}">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Diagnose" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Nacht}" />
    <Border Grid.Row="1" Margin="0,16" Background="{StaticResource Rauch}" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="Report" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 FontFamily="Consolas" FontSize="12.5" TextWrapping="NoWrap" Text="Diagnose läuft …" />
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Kopieren" Style="{StaticResource Ghost}" Click="OnCopy" />
      <Button Content="Schliessen" Style="{StaticResource Primary}" Margin="16,0,0,0" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
