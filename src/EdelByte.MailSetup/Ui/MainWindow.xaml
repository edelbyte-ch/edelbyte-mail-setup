<Window x:Class="EdelByte.MailSetup.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdelByte Mail Setup" Height="620" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource Weiss}" FontSize="14">
  <Grid Margin="34,30,34,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Kopf -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="EDELBYTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Blau}"
                 Margin="0,0,0,6">
        <TextBlock.LayoutTransform><ScaleTransform /></TextBlock.LayoutTransform>
      </TextBlock>
      <TextBlock Text="Mail einrichten" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Nacht}" />
    </StackPanel>

    <!-- Eingabe -->
    <StackPanel Grid.Row="1" x:Name="FormPanel" VerticalAlignment="Top" Margin="0,28,0,0">
      <TextBlock Text="E-Mail-Adresse" Foreground="{StaticResource Nacht}" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBox x:Name="EmailBox" Style="{StaticResource Field}" />

      <TextBlock Text="Passwort" Foreground="{StaticResource Nacht}" FontWeight="SemiBold" Margin="0,18,0,6" />
      <PasswordBox x:Name="PasswordBox" Style="{StaticResource Field}" />

      <TextBlock x:Name="Hint" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource FgMuted}"
                 Text="Ihr Passwort bleibt auf diesem Computer und wird nur an Ihren Mailserver gesendet." FontSize="12.5" />

      <Button x:Name="StartButton" Content="Mail einrichten" Style="{StaticResource Primary}"
              Margin="0,24,0,0" Click="OnStart" />

      <TextBlock x:Name="ErrorText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#C0392B"
                 Visibility="Collapsed" FontSize="13" />
      <Button x:Name="DiagnoseLink" Content="Diagnose anzeigen" Style="{StaticResource Ghost}"
              HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" Click="OnShowDiagnose" />
    </StackPanel>

    <!-- Fortschritt -->
    <StackPanel Grid.Row="1" x:Name="ProgressPanel" VerticalAlignment="Top" Margin="0,20,0,0" Visibility="Collapsed">
      <ItemsControl x:Name="StepList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" FontSize="15" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="15" />
              <TextBlock Grid.Column="2" Text="{Binding Note}" Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="StatusText" Margin="26,14,0,0" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap" FontSize="13" />

      <StackPanel x:Name="DonePanel" Margin="26,22,0,0" Visibility="Collapsed">
        <TextBlock Text="Fertig." FontSize="22" FontWeight="Bold" Foreground="{StaticResource Nacht}" />
        <TextBlock Text="Outlook ist eingerichtet. E-Mail, Kalender und Kontakte werden jetzt geladen."
                   TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" Margin="0,6,0,0" />
        <Button Content="Schliessen" Style="{StaticResource Primary}" Margin="0,20,0,0"
                HorizontalAlignment="Left" Click="OnClose" />
      </StackPanel>

      <StackPanel x:Name="FailPanel" Margin="26,22,0,0" Visibility="Collapsed">
        <TextBlock x:Name="FailText" FontSize="16" FontWeight="Bold" Foreground="#C0392B" TextWrapping="Wrap" />
        <TextBlock x:Name="FailCode" FontSize="12" Foreground="{StaticResource FgMuted}" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="Diagnose anzeigen" Style="{StaticResource Ghost}" Click="OnShowDiagnose" />
          <Button Content="Support kopieren" Style="{StaticResource Ghost}" Margin="16,0,0,0" Click="OnCopySupport" />
          <Button Content="Nochmals" Style="{StaticResource Ghost}" Margin="16,0,0,0" Click="OnRetry" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- Fuss -->
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <TextBlock x:Name="VersionText" Foreground="{StaticResource FgMuted}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" />
      <Button x:Name="ExpertToggle" Content="Details" Style="{StaticResource Ghost}" FontSize="11"
              HorizontalAlignment="Right" Click="OnToggleExpert" />
    </Grid>
  </Grid>
</Window>
