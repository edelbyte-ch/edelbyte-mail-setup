<Application x:Class="EdelByte.MailSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- EdelByte V5: Blau als Fläche, Schwarz (Nacht), Weiss -->
    <SolidColorBrush x:Key="Blau" Color="#1F5BFF" />
    <SolidColorBrush x:Key="BlauTief" Color="#123FC2" />
    <SolidColorBrush x:Key="Nacht" Color="#0B0E1A" />
    <SolidColorBrush x:Key="Weiss" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Rauch" Color="#EEF1F7" />
    <SolidColorBrush x:Key="Rauch2" Color="#DFE4EE" />
    <SolidColorBrush x:Key="Linie" Color="#22000000" />
    <SolidColorBrush x:Key="FgMuted" Color="#9E0B0E1A" />

    <Style TargetType="{x:Type Window}">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Blau}" />
      <Setter Property="Foreground" Value="{StaticResource Weiss}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="24,13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource BlauTief}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Blau}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="Control">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="BorderBrush" Value="{StaticResource Rauch2}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
  </Application.Resources>
</Application>
